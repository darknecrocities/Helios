{
  "architectures": [
    "HeliosForCausalLM"
  ],
  "model_type": "helios",
  "auto_map": {
    "AutoConfig": "helios.model.config.HeliosConfig",
    "AutoModelForCausalLM": "helios.model.transformer.HeliosForCausalLM",
    "AutoTokenizer": "helios.tokenizer.base.HeliosTokenizer"
  },
  "vocab_size": 32000,
  "hidden_size": 320,
  "num_hidden_layers": 7,
  "num_attention_heads": 8,
  "num_key_value_heads": 2,
  "intermediate_size": 864,
  "max_position_embeddings": 512,
  "rope_theta": 10000.0,
  "rms_norm_eps": 1e-05,
  "tie_word_embeddings": true,
  "initializer_range": 0.02,
  "dropout": 0.0,
  "torch_dtype": "float32",
  "transformers_version": "4.40.0",
  "model_family": "Helios",
  "developer": "Arron Kian Parejas",
  "developer_email": "arronkianparejas@gmail.com"
}