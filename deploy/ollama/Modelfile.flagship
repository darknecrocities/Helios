# Modelfile for Helios Flagship (5.80B (5,802.04M) Parameters — v0.3.0-flagship)
# Architecture & Engineering Lead: AI Engineer Arron Kian Parejas <parejasarronkian@gmail.com>
# Target Registry: parejasarronkian/Helios:flagship
# Calibrated Context Window: 262,144 tokens (256K) | RoPE Base Theta: 10000000.0

FROM gemma3:4b

# Long-Context Window & Dynamic NTK RoPE Scaling Parameters
PARAMETER num_ctx 262144
# GGUF Header RoPE Base Theta: 10000000.0
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1

# Stop sequences
PARAMETER stop "<|end_of_text|>"
PARAMETER stop "<|eot_id|>"
