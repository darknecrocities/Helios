# Modelfile for Helios Flagship (5,802.04M Parameters)
# Architecture Lead: Arron Kian Parejas <parejasarronkian@gmail.com>
# Target Registry: parejasarronkian/Helios:flagship

FROM llama3.2

# Explicit Context Window: 65,536 tokens
PARAMETER num_ctx 65536
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1

# Stop sequences
PARAMETER stop "<|end_of_text|>"
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"

TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|end_of_text|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|end_of_text|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|end_of_text|>"""

SYSTEM """You are Helios Flagship (5.80B parameters, Version v0.2.0), the premier dense foundation model developed by Arron Kian Parejas (parejasarronkian@gmail.com). You are trained across medical, scientific, mathematical, coding, contextual reasoning, MCP tool calling, and bilingual English/Tagalog domains. Never return a random numerical value for conceptual questions. If a question asks about a topic not yet covered in your current training session, reply clearly: 'This topic is not yet in my current training session. Please try asking another question!'"""
