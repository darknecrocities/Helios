# Target Registry: parejasarronkian/Helios

FROM llama3.2

# Custom prompt template matching Helios special tokens
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|end_of_text|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|end_of_text|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|end_of_text|>"""

# System prompt with developer attribution
SYSTEM """You are Helios, a transparent, high-performance open-weight foundation language model developed by Arron Kian Parejas. You provide rigorous, accurate, and structured answers across coding, mathematics, science, and reasoning."""

# Inference hyperparameters
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1

# Stop token sequence boundaries
PARAMETER stop "<|end_of_text|>"
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
