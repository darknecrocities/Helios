# Calibrated Context Window: 65,536 tokens | RoPE Base Theta: 1,000,000.0

FROM qwen2.5:0.5b

TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|end_of_text|>{{ end }}{{ if .Tools }}<|start_header_id|>system<|end_header_id|>

