 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Helios — Google Colab Training & Deployment Pipeline\n",
    "\n",
    "Trains the Helios family, exports GGUF, updates Hugging Face + Ollama, and syncs the repo.\n",
    "\n",
    "**Runtime:** GPU (T4/A100 recommended). Change runtime to GPU before running."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!nvidia-smi || true\n",
    "!git clone https://github.com/darknecrocities/Helios.git /content/helios 2>/dev/null || (cd /content/helios && git pull)\n",
    "%cd /content/helios\n",
    "!git checkout pretrained\n",
    "!pip -q install -r requirements.txt 2>/dev/null; pip -q install datasets transformers accelerate safetensors huggingface_hub gguf 2>/dev/null\n",
    "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Hugging Face auth (set HF_TOKEN in Colab secrets)\n",
    "import os\n",
    "try:\n",
    "    from google.colab import userdata\n",
    "    os.environ['HF_TOKEN'] = userdata.get('HF_TOKEN')\n",
    "except Exception:\n",
    "    pass\n",
    "from huggingface_hub import login\n",
    "if os.environ.get('HF_TOKEN'):\n",
    "    login(token=os.environ['HF_TOKEN'])\n",
    "    print('HF logged in')\n",
    "else:\n",
    "    print('No HF_TOKEN; set it in Colab secrets for push')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build 500M-token FineWeb corpus (resumable)\n",
    "!HF_HOME=/content/hf_cache python scripts/build_pretrain_shards.py \\\n",
    "  --out-dir /content/datasets/helios_fineweb_v2 \\\n",
    "  --tokenizer /content/helios/checkpoints/helios_nano \\\n",
    "  --source \"HuggingFaceFW/fineweb|sample-10BT|train|text|200000|odc-by\" \\\n",
    "  --source \"HuggingFaceFW/fineweb-edu|sample-10BT|train|text|50000|odc-by\" \\\n",
    "  --shard-tokens 20000000 --val-shard-tokens 5000000 --val-every 100 --checkpoint-every 1000\n",
    "!python scripts/verify_pretrain_shards.py --dataset-dir /content/datasets/helios_fineweb_v2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train Nano full-parameter continuation (example)\n",
    "!python scripts/continue_full_family_lineage.py --tier nano --steps 2000 --seq-len 512 --batch-size 8 --lr 3e-4 --out /content/checkpoints/nano_v2\n",
    "!ls -la /content/checkpoints/nano_v2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Export GGUF (placeholder; implement in helios/export/gguf.py)\n",
    "!python -c \"print('GGUF export step: implement helios/export/gguf.py export for each tier')\"\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sync repo\n",
    "!git config user.email 'parejasarronkian@gmail.com'\n",
    "!git config user.name 'Arron Kian Parejas'\n",
    "!git add -A && git commit -m 'colab: training + export run' || true\n",
    "!git push origin pretrained\n",
    "print('Repo synced')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ollama setup (Colab) + create models from Modelfiles\n",
    "!curl -fsSL https://ollama.com/install.sh | sh\n",
    "!ollama serve &\n",
    "import time; time.sleep(5)\n",
    "!cd /content/helios && for f in deploy/ollama/Modelfile*; do tag=$(basename $f | sed 's/Modelfile//;s/^\\./:/;s/^$/latest/'); echo \"Building $tag from $f\"; ollama create parejasarronkian/Helios${tag} -f $f || true; done\n",
    "!ollama list"
   ]
  }
 ],
